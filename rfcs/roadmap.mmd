flowchart TB
    START[DNS implementation roadmap]

    subgraph P0[Phase 0 — Specification and registry policy]
        direction LR
        S0[Policy foundations] --> F0[normative directory]
        F0 --> R2119[RFC 2119 — Requirement language]
        F0 --> R8174[RFC 8174 — Requirement-language clarification]
        F0 --> R8126[RFC 8126 — IANA registration policy]
    end

    subgraph P1[Phase 1 — Core DNS · crates/dns]
        direction LR
        S1[Core DNS] --> F1A[DNS model and wire format]
        S1 --> F1B[Record model and addressing]
        F1A --> R1034[RFC 1034 — Namespace and delegation]
        F1A --> R1035[RFC 1035 — Messages names and base RRs]
        F1A --> R2181[RFC 2181 — DNS semantic clarifications]
        F1A --> R4343[RFC 4343 — Case insensitive names]
        F1B --> R3597[RFC 3597 — Unknown RRs]
        F1B --> R6895[RFC 6895 — DNS parameters]
        F1B --> R1982[RFC 1982 — Serial arithmetic]
        F1B --> R3596[RFC 3596 — AAAA and IPv6 reverse DNS]
        F1B --> R2782[RFC 2782 — SRV]
        F1B --> R2317[RFC 2317 — Classless IPv4 reverse delegation]
        F1B --> R6761[RFC 6761 — Special use domain names]
    end

    subgraph P2[Phase 2 — Resolver extensions · crates/dns]
        direction LR
        S2[Resolver extensions] --> F2A[Caching and EDNS]
        S2 --> F2B[Application records]
        F2A --> R2308[RFC 2308 — Negative caching]
        F2A --> R6891[RFC 6891 — EDNS zero]
        F2A --> R7830[RFC 7830 — EDNS padding]
        F2A --> R8467[RFC 8467 — Padding policy]
        F2A --> R8914[RFC 8914 — Extended DNS Errors]
        F2B --> R6844[RFC 6844 — CAA]
    end

    subgraph P3[Phase 3 — Authority updates and cleartext transfer · dns + transport]
        direction LR
        S3[Authoritative DNS] --> F3A[Updates and synchronization]
        S3 --> F3B[Zone transfer]
        S3 --> F3C[Legacy secure update compatibility]
        F3A --> R2136[RFC 2136 — Dynamic Update]
        F3A --> R1996[RFC 1996 — NOTIFY]
        F3A --> R7477[RFC 7477 — CSYNC]
        F3A --> R8945[RFC 8945 — TSIG]
        F3B --> R7766[RFC 7766 — DNS over TCP]
        F3B --> R5936[RFC 5936 — AXFR]
        F3B --> R1995[RFC 1995 — IXFR]
        F3C --> R2931[RFC 2931 — SIG zero]
        F3C --> R3007[RFC 3007 — Secure Dynamic Update]
    end

    subgraph P4[Phase 4 — DNSSEC · crates/dns]
        direction LR
        S4[DNSSEC] --> F4A[DNSSEC core]
        S4 --> F4B[Authenticated denial and algorithms]
        F4A --> R4033[RFC 4033 — Architecture]
        F4A --> R4034[RFC 4034 — DNSSEC records and canonicalization]
        F4A --> R4035[RFC 4035 — Validation protocol]
        F4A --> R6840[RFC 6840 — Clarifications]
        F4A --> R9364[RFC 9364 — DNSSEC BCP]
        F4B --> R5155[RFC 5155 — NSEC3]
        F4B --> R4509[RFC 4509 — SHA 256 DS digest]
        F4B --> R5702[RFC 5702 — RSA SHA 2]
        F4B --> R6944[RFC 6944 — Algorithm implementation status]
        F4B --> R6975[RFC 6975 — Algorithm understanding signal]
    end

    subgraph P5[Phase 5 — Secure DNS applications and discovery · crates/dns]
        direction LR
        S5[Secure DNS and discovery] --> F5A[Secure DNS applications]
        S5 --> F5B[Local discovery]
        S5 --> F5C[DNS change notifications]
        F5A --> R6698[RFC 6698 — DANE TLSA]
        F5A --> R8162[RFC 8162 — S MIMEA experimental]
        F5B --> R6762[RFC 6762 — Multicast DNS]
        F5B --> R6763[RFC 6763 — DNS Based Service Discovery]
        F5C --> R8764[RFC 8764 — Apple LLQ legacy]
        F5C --> R8765[RFC 8765 — DNS Push Notifications]
    end

    subgraph P6[Phase 6 — TLS and encrypted TCP DNS · crates/transport]
        direction LR
        S6[TLS transport] --> F6A[TLS foundation]
        S6 --> F6B[DNS over TLS]
        F6A --> R8446[RFC 8446 — TLS 1.3]
        F6A --> R7301[RFC 7301 — ALPN]
        F6B --> R7858[RFC 7858 — DNS over TLS]
        F6B --> R8310[RFC 8310 — DoT usage profiles]
        F6B --> R9103[RFC 9103 — Zone transfer over TLS]
    end

    subgraph P7[Phase 7 — HTTPS QUIC and alternative transports · crates/transport]
        direction LR
        S7[Encrypted modern transports] --> F7A[HTTPS]
        S7 --> F7B[QUIC]
        S7 --> F7C[Alternative encrypted transport]
        F7A --> R8484[RFC 8484 — DNS over HTTPS]
        F7B --> R9001[RFC 9001 — TLS for QUIC]
        F7B --> R9000[RFC 9000 — QUIC transport]
        F7B --> R9250[RFC 9250 — DNS over QUIC]
        F7C --> DNSCrypt[draft denis dprive dnscrypt — DNSCrypt]
    end

    subgraph X[Out of DNS implementation scope]
        direction LR
        SX[Reference only] --> R9470[RFC 9470 — OAuth 2.0 Step Up Authentication]
    end

    START --> S0 --> S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7
    START --> SX

