ARG RUST_IMAGE=rust:bookworm

# Build the standalone CLI.
FROM ${RUST_IMAGE} AS builder

WORKDIR /source

COPY Cargo.toml Cargo.lock ./
COPY src src
COPY config config
COPY crates crates
COPY vendor vendor

RUN cargo build \
    --locked \
    --release \
    --bin donna

# Run client commands without the build toolchain.
FROM debian:bookworm-slim AS client

LABEL org.opencontainers.image.licenses="Apache-2.0" \
    org.opencontainers.image.authors="ocku"

RUN groupadd --gid 10001 donna \
    && useradd \
        --uid 10001 \
        --gid donna \
        --no-create-home \
        --shell /usr/sbin/nologin \
        donna

COPY --from=builder /source/target/release/donna /usr/local/bin/donna
COPY LICENSE NOTICE /usr/share/licenses/donna/

USER 10001:10001

ENTRYPOINT ["/usr/local/bin/donna"]
CMD ["--help"]
